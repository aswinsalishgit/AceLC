{
  "manifest_version": 3,
  "name": "AceLC",
  "version": "1.0.0",
  "description": "Sync accepted LeetCode solutions directly to your GitHub repositories.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://github.com/*",
    "https://api.github.com/*",
    "https://leetcode.com/*"
  ],
  "action": {
    "default_popup": "Popup/popup.html",
    "default_title": "AceLC"
  },
  "options_ui": {
    "page": "Options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "Background/serviceWorker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*"
      ],
      "js": [
        "Shared/constants.js",
        "Content/leetcode.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://leetcode.com/problems/*"
      ],
      "js": [
        "Content/pageBridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "Content/pageBridge.js"
      ],
      "matches": [
        "https://leetcode.com/*"
      ]
    }
  ]
}
